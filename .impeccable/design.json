  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Lime primary action, with the source hover and keyboard-focus treatments.",
      "html": "<button class=\"ds-primary\">Apply configuration</button>",
      "css": ".ds-primary{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;line-height:1.25;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--line,#30393b);border-radius:5px;padding:8px 11px;cursor:pointer;background:var(--lime,#b5e87d);border-color:var(--lime,#b5e87d);color:#1b2819;font-weight:650}.ds-primary:hover:not(:disabled){background:#c9f2a0;border-color:#526263}.ds-primary:focus-visible{outline:2px solid var(--lime,#b5e87d);outline-offset:3px;}.ds-primary:disabled{opacity:.35;cursor:default}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Compact secondary action shared by configuration and inspection.",
      "html": "<button class=\"ds-secondary\">Jump to start</button>",
      "css": ".ds-secondary{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;line-height:1.25;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--line,#30393b);border-radius:5px;padding:8px 11px;cursor:pointer;background:#202729;color:#e6e9e7}.ds-secondary:hover:not(:disabled){background:#2a3334;border-color:#526263}.ds-secondary:focus-visible{outline:2px solid var(--lime,#b5e87d);outline-offset:3px;}.ds-secondary:disabled{opacity:.35;cursor:default}"
    },
    {
      "name": "Labeled number field",
      "kind": "input",
      "refersTo": "field",
      "description": "Native number input with a visible label and tabular numerals.",
      "html": "<label class=\"ds-field\"><span>Seed</span><input type=\"number\" value=\"42\"></label>",
      "css": ".ds-field{display:grid;gap:7px;max-width:220px;font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:11px}.ds-field>span{color:#adbcc0;font-size:10px}.ds-field input{height:36px;min-width:0;padding:9px 10px;color:#e6e9e7;background:#151a1b;border:1px solid #445052;border-radius:5px;font:inherit;font-variant-numeric:tabular-nums;caret-color:var(--lime,#b5e87d)}.ds-field input:focus-visible{outline:2px solid var(--lime,#b5e87d);outline-offset:3px;}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Active task and subdued neighboring task in the persistent navigation.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button class=\"ds-active\" aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"/></svg>Training simulator</button><button>Compare runs</button></nav>",
      "css": ".ds-nav{display:grid;gap:6px;width:190px;font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif}.ds-nav button{display:flex;align-items:center;gap:9px;justify-content:flex-start;padding:12px 9px;border:1px solid transparent;border-radius:5px;background:transparent;color:#b4c0c4;font:inherit;font-size:11px;cursor:pointer}.ds-nav .ds-active{background:#253121;border-color:#3d5135;color:var(--lime,#b5e87d)}.ds-nav button:hover{background:#2a3334;border-color:#526263}.ds-nav button:focus-visible{outline:2px solid var(--lime,#b5e87d);outline-offset:3px;}"
    },
    {
      "name": "Run tag",
      "kind": "chip",
      "refersTo": "run-tag",
      "description": "Low-emphasis noninteractive run identifier in comparison mode.",
      "html": "<span class=\"ds-run-tag\">Run A</span>",
      "css": ".ds-run-tag{display:inline-block;font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:9px;text-transform:uppercase;letter-spacing:.5px;padding:4px 6px;background:#26302f;border:1px solid #3d4948;border-radius:3px;color:#c0cfcb}"
    },
    {
      "name": "Selected rank card",
      "kind": "card",
      "refersTo": "rank-card",
      "description": "Rank selection is an outlined surface, with state written beside the rank.",
      "html": "<article class=\"ds-rank\"><button class=\"ds-rank-heading\"><strong>Rank 0</strong><span>Ready \u00b7 F</span></button><div class=\"ds-rank-meta\"><span>Matrix partition</span><span>Same samples on every rank</span></div><div class=\"ds-rank-bar\"><i></i><i></i></div><p class=\"ds-rank-memory\"><strong>60.0 MiB</strong> resident</p></article>",
      "css": ".ds-rank{font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;max-width:360px;background:#1e2526;border:1px solid #9dbd76;border-radius:6px;overflow:hidden;box-shadow:0 0 0 1px #9dbd7615;transition:border-color .12s;color:#e6e9e7}.ds-rank-heading{display:flex;gap:7px;width:100%;align-items:center;padding:12px 12px 6px;border:0;border-radius:0;background:transparent;color:inherit;cursor:pointer}.ds-rank-heading strong{font-size:11px;font-weight:600}.ds-rank-heading>span{margin-left:auto;font-size:8px;color:#9aa8ac}.ds-rank-heading:hover{background:#2a3334}.ds-rank-heading:focus-visible{outline:2px solid var(--lime,#b5e87d);outline-offset:3px;outline-offset:-3px}.ds-rank-meta{display:flex;justify-content:space-between;gap:5px;margin:2px 12px 11px;font-size:8px;line-height:1.4;color:#9aabad}.ds-rank-meta>span:first-child{color:#b2c7c5}.ds-rank-bar{display:flex;height:5px;margin:15px 12px 9px}.ds-rank-bar>i:first-child{width:33.33%;background:var(--cyan,#82c8d4)}.ds-rank-bar>i:last-child{flex:1;background:var(--purple,#b7a0dc)}.ds-rank-memory{font-size:9px;color:#9aa8ac;margin:0 12px 12px}.ds-rank-memory strong{color:#e6e9e7}@media(prefers-reduced-motion:reduce){.ds-rank{transition:none}}"
    },
    {
      "name": "Five-way strategy selector",
      "kind": "custom",
      "refersTo": "strategy-selected",
      "description": "One shared segmented control across DDP, FSDP, TP, PP, and EP.",
      "html": "<div class=\"ds-strategies\" role=\"group\" aria-label=\"Strategy\"><button aria-pressed=\"false\">DDP</button><button aria-pressed=\"false\">FSDP</button><button class=\"ds-selected\" aria-pressed=\"true\">TP</button><button aria-pressed=\"false\">PP</button><button aria-pressed=\"false\">EP</button></div>",
      "css": ".ds-strategies{display:flex;max-width:560px;height:36px;border:1px solid #445052;border-radius:5px;overflow:hidden;background:#171d1e;font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif}.ds-strategies button{flex:1;border:0;border-radius:0;padding:8px 9px;background:transparent;color:#e6e9e7;font:inherit;font-size:11px;cursor:pointer}.ds-strategies .ds-selected{color:var(--lime,#b5e87d);background:#2b3826;box-shadow:inset 0 -2px 0 var(--lime,#b5e87d)}.ds-strategies button:hover{background:#2a3334}.ds-strategies button:focus-visible{outline:2px solid var(--lime,#b5e87d);outline-offset:3px;outline-offset:-3px}"
    },
    {
      "name": "Ownership cells",
      "kind": "custom",
      "refersTo": "ownership-cell",
      "description": "Labeled owned and absent cells retain their meaning beyond color.",
      "html": "<div class=\"ds-ownership\"><strong>Rank 0</strong><div class=\"ds-cells\"><span>L1<small>full</small></span><span>L2<small>full</small></span><span class=\"ds-absent\">L3</span><span class=\"ds-absent\">L4</span></div><small>4 microbatches</small></div>",
      "css": ".ds-ownership{max-width:300px;font-family:Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;color:#e6e9e7}.ds-ownership>strong{display:block;margin-bottom:6px;font-size:11px;font-weight:550}.ds-ownership>small{display:block;margin-top:6px;color:var(--muted,#93a2a7);font-size:10px}.ds-cells{display:flex;gap:3px}.ds-cells>span{flex:1;min-width:0;padding:7px 3px;text-align:center;font-size:10px;border:1px solid #4c6240;background:#253020;border-radius:3px;color:#cce6b6}.ds-cells small{display:block;font-size:9px;margin-top:2px}.ds-cells .ds-absent{color:#839295;border-color:#30393b;background:transparent}"
    }
